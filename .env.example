# Local Postgres (Homebrew or Docker)
DATABASE_URL=postgresql://localhost/aequitas

# Session cookie signing (required for OAuth)
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth (create credentials at https://console.cloud.google.com/)
# Authorized redirect URI: http://localhost:8000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: invite emails via Brevo
BREVO_API_KEY=

# Local CORS / URLs
AEQUITAS_CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# Dev auth bypass (never set in production)
# DEV_AUTH_BYPASS=true
# ENVIRONMENT=development

# Chat
GEMINI_API_KEY=

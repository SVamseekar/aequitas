# ── Local Aequitas environment ──────────────────────────────────────────────
# Copy to .env and fill in as needed. Never commit .env.
# See AGENTS.md for the full local boot path (./scripts/dev.sh).

# ── Runtime mode ────────────────────────────────────────────────────────────
ENVIRONMENT=development

# Analytics-only local demos: bypass session cookies for protected API routes
# and return a synthetic dev user from /api/auth/me (unblocks ProtectedRoute).
# Allowed only when ENVIRONMENT is not "production". NEVER enable in prod.
DEV_AUTH_BYPASS=true

# ── Analytics warehouse (DuckDB, on disk) ───────────────────────────────────
AEQUITAS_DB_PATH=data/aequitas.duckdb
AEQUITAS_FAISS_INDEX=data/faiss_index.bin
AEQUITAS_FAISS_METADATA=data/faiss_metadata.json
AEQUITAS_CORS_ORIGINS=http://localhost:5173

# ── Postgres (auth / multi-tenancy — Part A) ────────────────────────────────
# Docker Compose (docker compose up -d):
#   DATABASE_URL=postgresql://aequitas:aequitas@localhost:5432/aequitas
# Homebrew / local cluster:
DATABASE_URL=postgresql://localhost/aequitas

# Session cookie signing (required for real OAuth; any long string for local)
SESSION_SECRET=change-me-to-a-long-random-string

# ── Google OAuth (full auth; optional if DEV_AUTH_BYPASS=true) ──────────────
# Create credentials at https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:8000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth / browser URLs
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# Optional: invite emails via Brevo
BREVO_API_KEY=

# ── Chat (optional — dashboard analytics work without it) ───────────────────
GEMINI_API_KEY=

# ── Ops / live reliability (Wave 8) — optional keys, never invent metrics ──
# BODS portal (data.bus-data.dft.gov.uk) GTFS-RT + SIRI-VM API. Without a key
# those endpoints 401; the public AVL zip is still tried.
# BODS_API_KEY=
# Ireland NTA developer.nationaltransport.ie — Dublin Bus, Bus Éireann, Go-Ahead
# only. Without a key Ireland ops stays honest-empty. Do not invent the rest
# of the Republic.
# NTA_API_KEY=
# AEQUITAS_OPS_DIR=data/ops

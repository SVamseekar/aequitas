# AI tool artifacts — never commit
.superpowers/
.playwright-mcp/
.serena/
.claude/
.cursor/
.aider*
.copilot/

# Auth state / session tokens
frontend/scripts/.auth-state.json

# Debug screenshots — generated at runtime, not source
*.png
*.jpg
*.jpeg
!frontend/public/**
!frontend/src/assets/**
!data/audit/figures-registry.json

# Data — never commit raw or processed data
data/raw/
data/processed/
data/audit/*.json
data/audit/*.png
data/audit/figures/
!data/audit/ground_truth.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
*.egg

# Jupyter
.ipynb_checkpoints/
*.ipynb~

# DuckDB warehouse (large binary — use Git LFS in deployment)
*.duckdb
*.duckdb.wal
data/packs/**/*.duckdb
data/packs/**/*.bak
!data/packs/manifest.json
!data/packs/**/metrics.json

# ML models & FAISS indices
data/models/
data/faiss_index.bin
data/faiss_metadata.json
*.pkl
*.joblib
*.faiss

# Logs
logs/
*.log

# Environment
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Git worktrees
.worktrees/

# Documentation (kept locally only, except the future-work backlog)
docs/*
!docs/FUTURE_WORK.md
!docs/CURRENT_STATE.md
!docs/HANDOFF_CV_AND_PITCH.md
!docs/OAUTH_LOCAL_SETUP.md
!docs/SEARCH_CONSOLE.md
!docs/A11Y_REPORT.md
!docs/guidelines/
ISSUES.md
frontend/README.md
.vercel
.env*.local

